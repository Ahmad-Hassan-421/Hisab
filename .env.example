# Set in your shell or deployment settings before starting the backend.
# Use the URI of a MongoDB replica set or sharded cluster.
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGO_DATABASE=hisab_db
JWT_SECRET=
HOST=127.0.0.1
PORT=8081
HISAB_ENV=development
UPLOAD_DIR=uploads
CORS_ALLOWED_ORIGINS=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Android build settings
HISAB_DEBUG_API_URL=http://127.0.0.1:8081/
HISAB_RELEASE_API_URL=
