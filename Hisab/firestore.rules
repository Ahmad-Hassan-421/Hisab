rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function: check if user is a member of the group
    function isMember(groupData) {
      return isAuthenticated() && request.auth.uid in groupData.members;
    }
    
    // Users collection
    // - Any authenticated user can read any user document (for ID lookup during invites)
    // - Only the owner can write/update their own document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }
    
    // Hisab requests collection
    // - Sender can create a request
    // - Only the receiver can read their incoming requests
    // - Only the receiver can update the status (accept/decline)
    // - No one can delete requests (keep audit trail)
    match /hisab_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow read: if isAuthenticated() && 
                     (resource.data.receiverId == request.auth.uid || 
                      resource.data.senderId == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.receiverId == request.auth.uid;
      allow delete: if false; // Preserve all requests for audit
    }
    
    // Hisab groups collection
    // - Only members can read the group
    // - Only members can write/update the group (add expenses, etc.)
    // - Members cannot delete groups (prevents accidental data loss)
    match /hisab_groups/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow delete: if false; // Prevent accidental group deletion
    }
    
    // Expenses subcollection under hisab_groups
    // - Only group members can read/write expenses
    match /hisab_groups/{groupId}/expenses/{expenseId} {
      allow read, write: if isAuthenticated() && 
                            request.auth.uid in get(/databases/$(database)/documents/hisab_groups/$(groupId)).data.members;
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
